! Default animation profile
!
! Valid ease values:
!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
! NONE
! LINEAR
! EASE_OUT
! EASE_IN
! ELASTIC
! BOUNCE
!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


%anim 
    ease        : EASE_IN
    speed       : 0.10
    overshoot   : 0.00
    stiffness   : 1.50
    damping     : 0.75
%anim